data = {
"en": PackedStringArray("{monster} can\'t beleive you made it!", "{monster} thinks you cheated.", "It\'s a good thing you didn\'t run into {monster}!", "{monster} is very proud of you!", "{monster} would like to know your secret!", "{monster} dares you to try again!", "{monster} knew you could do it!", "{monster} had one job...", "{monster} will be demoted for this!", "{monster} is a little jealous of your accomplishment.", "Now who is {monster} supposed to eat?", "{monster} underestimated you!", "{monster} wants your autograph!", "{monster} is disappointed in all of monsterkind.", "{monster} is getting too old for this.", "{monster} wants a buff.")
