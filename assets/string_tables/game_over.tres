script = ExtResource("1_uc046")
data = {
"en": PackedStringArray("{cause} eagerly gnaws on your remains.", "The global monster community praises {cause} for a job well-done.", "Death, thy name is {cause}.", "Of all dangers in this world, there are none as terrible as {cause}.", "As your vision fades, you see {cause} rip out a vital organ or two.", "Cause: A devastating blow from {cause}.", "You did not wake up this morning expecting to find the {cause}.", "{cause} is just as surprised as you are.", "The world may not remember you, but it will remember {cause}.", "{cause} sends its regards.", "On the bright side, {cause} gained a level.", "{cause} will not let any part of your body go to waste.", "If it\'s any consolation, {cause} only meant to scare you.", "{cause} just stole all of your items, too.", "{cause} would go on to live forever.", "When you get to hell, tell them {cause} sent you.", "{cause} had been plotting your demise for many years.", "{cause}, please report to the Monster\'s Guild to collect your reward.", "This is not your story. It is {cause}\'s story.", "This is what you get for messing with {cause}.", "Your dying screams annoyed {cause} a great deal.", "{cause} kept some of your bones as a memento.", "{cause} claims another victim.", "{cause} laughs maniacally.", "This {cause} is a real jerk.", "Try to avoid clicking on {cause} next time.", "There is no shame in dying to {cause}.", "The world belongs to {cause}.", "{cause} thinks you taste funny.", "Oops! {cause} thought you were a bad guy.", "{cause} wasn\'t even trying.", "{cause} is going to tell all its friends about this.", "{cause} wants a real opponent.", "{cause} left quite the impression.", "Why did you click on {cause}?", "{cause}. What a way to go.", "{cause} was hoping you\'d click there.", "{cause} is no joke.", "\"NO PRISONERS!\" screams {cause}.", "We all feel the wrath of {cause} eventually.", "Can anyone stop {cause}?", "{cause} is on a killing spree.", "{cause} was holding back its true power.", "{cause} was feeling naughty.", "Have you tried not dying?", "Do you believe in life after DemonCrawl?", "Failure is the breakfast of champions.", "Unbelievable!", "This game is too hard.", "Pfffft.")
}
